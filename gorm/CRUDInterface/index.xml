<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>CRUD 接口 on Go 中文档集</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/</link><description>Recent content in CRUD 接口 on Go 中文档集</description><generator>Hugo</generator><language>zh-cn</language><lastBuildDate>Thu, 10 Oct 2024 15:07:50 +0800</lastBuildDate><atom:link href="https://before80.github.io/go_docs/gorm/CRUDInterface/index.xml" rel="self" type="application/rss+xml"/><item><title>创建</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/create/</link><pubDate>Sat, 28 Oct 2023 14:25:34 +0800</pubDate><guid>https://before80.github.io/go_docs/gorm/CRUDInterface/create/</guid><description>&lt;blockquote>
&lt;p>原文：&lt;a href="https://gorm.io/docs/create.html">https://gorm.io/docs/create.html&lt;/a>&lt;/p>&lt;/blockquote>
&lt;h2 id="创建记录-create-record">创建记录 Create Record&lt;a class="td-heading-self-link" href="#%e5%88%9b%e5%bb%ba%e8%ae%b0%e5%bd%95-create-record" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;div class="highlight">&lt;div style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">
&lt;table style="border-spacing:0;padding:0;margin:0;border:0;">&lt;tr>&lt;td style="vertical-align:top;padding:0;margin:0;border:0;">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">1
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">2
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">3
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">4
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">5
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">6
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">7
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-go" data-lang="go">&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">user&lt;/span> &lt;span style="color:#54b1c7">:=&lt;/span> &lt;span style="color:#aa89ea">User&lt;/span>&lt;span style="color:#abb2bf">{&lt;/span>&lt;span style="color:#aa89ea">Name&lt;/span>&lt;span style="color:#abb2bf">:&lt;/span> &lt;span style="color:#98c379">&amp;#34;Jinzhu&amp;#34;&lt;/span>&lt;span style="color:#abb2bf">,&lt;/span> &lt;span style="color:#aa89ea">Age&lt;/span>&lt;span style="color:#abb2bf">:&lt;/span> &lt;span style="color:#d19a66">18&lt;/span>&lt;span style="color:#abb2bf">,&lt;/span> &lt;span style="color:#aa89ea">Birthday&lt;/span>&lt;span style="color:#abb2bf">:&lt;/span> &lt;span style="color:#aa89ea">time&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#00b1f7">Now&lt;/span>&lt;span style="color:#abb2bf">()}&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">result&lt;/span> &lt;span style="color:#54b1c7">:=&lt;/span> &lt;span style="color:#aa89ea">db&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#00b1f7">Create&lt;/span>&lt;span style="color:#abb2bf">(&lt;/span>&lt;span style="color:#54b1c7">&amp;amp;&lt;/span>&lt;span style="color:#aa89ea">user&lt;/span>&lt;span style="color:#abb2bf">)&lt;/span> &lt;span style="color:#8a93a5;font-style:italic">// 将数据指针传递给Create pass pointer of data to Create&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">user&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#aa89ea">ID&lt;/span> &lt;span style="color:#8a93a5;font-style:italic">// 返回插入数据的主键 returns inserted data&amp;#39;s primary key&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">result&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#aa89ea">Error&lt;/span> &lt;span style="color:#8a93a5;font-style:italic">// 返回错误 returns error&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">result&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#aa89ea">RowsAffected&lt;/span> &lt;span style="color:#8a93a5;font-style:italic">// 返回插入的记录数 returns inserted records count&lt;/span>
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>We can also create multiple records with &lt;code>Create()&lt;/code>:&lt;/p></description></item><item><title>查询</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/query/</link><pubDate>Sat, 28 Oct 2023 14:25:43 +0800</pubDate><guid>https://before80.github.io/go_docs/gorm/CRUDInterface/query/</guid><description>&lt;blockquote>
&lt;p>原文：&lt;a href="https://gorm.io/docs/query.html">https://gorm.io/docs/query.html&lt;/a>&lt;/p>&lt;/blockquote>
&lt;h2 id="检索单个对象-retrieving-a-single-object">检索单个对象 Retrieving a single object&lt;a class="td-heading-self-link" href="#%e6%a3%80%e7%b4%a2%e5%8d%95%e4%b8%aa%e5%af%b9%e8%b1%a1-retrieving-a-single-object" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;p>GORM provides &lt;code>First&lt;/code>, &lt;code>Take&lt;/code>, &lt;code>Last&lt;/code> methods to retrieve a single object from the database, it adds &lt;code>LIMIT 1&lt;/code> condition when querying the database, and it will return the error &lt;code>ErrRecordNotFound&lt;/code> if no record is found.&lt;/p>
&lt;p>​	GORM提供了&lt;code>First&lt;/code>、&lt;code>Take&lt;/code>和&lt;code>Last&lt;/code>方法来从数据库中检索单个对象。当查询数据库时，它会添加&lt;code>LIMIT 1&lt;/code>条件，如果没有找到记录，它将返回错误&lt;code>ErrRecordNotFound&lt;/code>。&lt;/p></description></item><item><title>高级查询</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/advancedQuery/</link><pubDate>Sat, 28 Oct 2023 14:26:01 +0800</pubDate><guid>https://before80.github.io/go_docs/gorm/CRUDInterface/advancedQuery/</guid><description>&lt;blockquote>
&lt;p>原文：&lt;a href="https://gorm.io/docs/advanced_query.html">https://gorm.io/docs/advanced_query.html&lt;/a>&lt;/p>&lt;/blockquote>
&lt;h2 id="智能选择字段-smart-select-fields">智能选择字段 Smart Select Fields&lt;a class="td-heading-self-link" href="#%e6%99%ba%e8%83%bd%e9%80%89%e6%8b%a9%e5%ad%97%e6%ae%b5-smart-select-fields" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;p>GORM allows selecting specific fields with &lt;a href="https://gorm.io/docs/query.html">&lt;code>Select&lt;/code>&lt;/a>, if you often use this in your application, maybe you want to define a smaller struct for API usage which can select specific fields automatically, for example:&lt;/p>
&lt;p>​	GORM 允许使用 &lt;a href="https://gorm.io/docs/query.html">&lt;code>Select&lt;/code>&lt;/a> 来选择特定的字段，如果你在应用程序中经常使用这个功能，也许你想要为 API 定义一个较小的结构体，以便自动选择特定的字段，例如：&lt;/p></description></item><item><title>更新</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/update/</link><pubDate>Sat, 28 Oct 2023 14:26:11 +0800</pubDate><guid>https://before80.github.io/go_docs/gorm/CRUDInterface/update/</guid><description>&lt;blockquote>
&lt;p>原文：&lt;a href="https://gorm.io/docs/update.html">https://gorm.io/docs/update.html&lt;/a>&lt;/p>&lt;/blockquote>
&lt;h2 id="保存所有字段-save-all-fields">保存所有字段 Save All Fields&lt;a class="td-heading-self-link" href="#%e4%bf%9d%e5%ad%98%e6%89%80%e6%9c%89%e5%ad%97%e6%ae%b5-save-all-fields" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;p>&lt;code>Save&lt;/code> will save all fields when performing the Updating SQL&lt;/p>
&lt;p>​	&lt;code>Save&lt;/code> 在执行更新 SQL 时会保存所有字段。&lt;/p>
&lt;div class="highlight">&lt;div style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">
&lt;table style="border-spacing:0;padding:0;margin:0;border:0;">&lt;tr>&lt;td style="vertical-align:top;padding:0;margin:0;border:0;">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">1
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">2
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">3
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">4
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">5
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">6
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-go" data-lang="go">&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">db&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#00b1f7">First&lt;/span>&lt;span style="color:#abb2bf">(&lt;/span>&lt;span style="color:#54b1c7">&amp;amp;&lt;/span>&lt;span style="color:#aa89ea">user&lt;/span>&lt;span style="color:#abb2bf">)&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">user&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#aa89ea">Name&lt;/span> &lt;span style="color:#abb2bf">=&lt;/span> &lt;span style="color:#98c379">&amp;#34;jinzhu 2&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">user&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#aa89ea">Age&lt;/span> &lt;span style="color:#abb2bf">=&lt;/span> &lt;span style="color:#d19a66">100&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">db&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#00b1f7">Save&lt;/span>&lt;span style="color:#abb2bf">(&lt;/span>&lt;span style="color:#54b1c7">&amp;amp;&lt;/span>&lt;span style="color:#aa89ea">user&lt;/span>&lt;span style="color:#abb2bf">)&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8a93a5;font-style:italic">// UPDATE users SET name=&amp;#39;jinzhu 2&amp;#39;, age=100, birthday=&amp;#39;2016-01-01&amp;#39;, updated_at = &amp;#39;2013-11-17 21:34:10&amp;#39; WHERE id=111;&lt;/span>
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;p>&lt;code>Save&lt;/code> is a combination function. If save value does not contain primary key, it will execute &lt;code>Create&lt;/code>, otherwise it will execute &lt;code>Update&lt;/code> (with all fields).&lt;/p></description></item><item><title>删除</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/delete/</link><pubDate>Sat, 28 Oct 2023 14:26:18 +0800</pubDate><guid>https://before80.github.io/go_docs/gorm/CRUDInterface/delete/</guid><description>&lt;blockquote>
&lt;p>原文：&lt;a href="https://gorm.io/docs/delete.html">https://gorm.io/docs/delete.html&lt;/a>&lt;/p>&lt;/blockquote>
&lt;h2 id="删除记录-delete-a-record">删除记录 Delete a Record&lt;a class="td-heading-self-link" href="#%e5%88%a0%e9%99%a4%e8%ae%b0%e5%bd%95-delete-a-record" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;p>When deleting a record, the deleted value needs to have primary key or it will trigger a &lt;a href="https://gorm.io/docs/delete.html#batch_delete">Batch Delete&lt;/a>, for example:&lt;/p>
&lt;p>​	当删除记录时，被删除的值需要有主键，否则会触发&lt;a href="https://gorm.io/docs/delete.html#batch_delete">批量删除&lt;/a>，例如：&lt;/p>
&lt;div class="highlight">&lt;div style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">
&lt;table style="border-spacing:0;padding:0;margin:0;border:0;">&lt;tr>&lt;td style="vertical-align:top;padding:0;margin:0;border:0;">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">1
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">2
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">3
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">4
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">5
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">6
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f">7
&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-go" data-lang="go">&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8a93a5;font-style:italic">// Email的ID是`10` Email&amp;#39;s ID is `10`&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">db&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#00b1f7">Delete&lt;/span>&lt;span style="color:#abb2bf">(&lt;/span>&lt;span style="color:#54b1c7">&amp;amp;&lt;/span>&lt;span style="color:#aa89ea">email&lt;/span>&lt;span style="color:#abb2bf">)&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8a93a5;font-style:italic">// DELETE from emails where id = 10;&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8a93a5;font-style:italic">// 使用附加条件进行删除 Delete with additional conditions&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#aa89ea">db&lt;/span>&lt;span style="color:#abb2bf">.&lt;/span>&lt;span style="color:#00b1f7">Where&lt;/span>&lt;span style="color:#abb2bf">(&lt;/span>&lt;span style="color:#98c379">&amp;#34;name = ?&amp;#34;&lt;/span>&lt;span style="color:#abb2bf">,&lt;/span> &lt;span style="color:#98c379">&amp;#34;jinzhu&amp;#34;&lt;/span>&lt;span style="color:#abb2bf">).&lt;/span>&lt;span style="color:#00b1f7">Delete&lt;/span>&lt;span style="color:#abb2bf">(&lt;/span>&lt;span style="color:#54b1c7">&amp;amp;&lt;/span>&lt;span style="color:#aa89ea">email&lt;/span>&lt;span style="color:#abb2bf">)&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8a93a5;font-style:italic">// DELETE from emails where id = 10 AND name = &amp;#34;jinzhu&amp;#34;;&lt;/span>
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
&lt;/div>
&lt;/div>&lt;h2 id="使用主键删除-delete-with-primary-key">使用主键删除 Delete with primary key&lt;a class="td-heading-self-link" href="#%e4%bd%bf%e7%94%a8%e4%b8%bb%e9%94%ae%e5%88%a0%e9%99%a4-delete-with-primary-key" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;p>GORM allows to delete objects using primary key(s) with inline condition, it works with numbers, check out &lt;a href="https://gorm.io/docs/query.html#inline_conditions">Query Inline Conditions&lt;/a> for details&lt;/p></description></item><item><title>SQL Builder</title><link>https://before80.github.io/go_docs/gorm/CRUDInterface/rawSQLAndSQLBuilder/</link><pubDate>Sat, 28 Oct 2023 14:26:51 +0800</pubDate><guid>https://before80.github.io/go_docs/gorm/CRUDInterface/rawSQLAndSQLBuilder/</guid><description>&lt;blockquote>
&lt;p>原文：&lt;a href="https://gorm.io/docs/sql_builder.html">https://gorm.io/docs/sql_builder.html&lt;/a>&lt;/p>&lt;/blockquote>
&lt;h2 id="原始sql-raw-sql">原始SQL Raw SQL&lt;a class="td-heading-self-link" href="#%e5%8e%9f%e5%a7%8bsql-raw-sql" aria-label="Heading self-link">&lt;/a>&lt;/h2>
&lt;p>Query Raw SQL with &lt;code>Scan&lt;/code>&lt;/p>
&lt;p>​	使用&lt;code>Scan&lt;/code>查询原始SQL&lt;/p>
&lt;div class="highlight">&lt;div style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">
&lt;table style="border-spacing:0;padding:0;margin:0;border:0;">&lt;tr>&lt;td style="vertical-align:top;padding:0;margin:0;border:0;">
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 1
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 2
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 3
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 4
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 5
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 6
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 7
&lt;/span>&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"> 8
