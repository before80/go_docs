 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;a href="https://github.com/multiplay/go-slack"&gt;Go-Slack&lt;/a&gt;&lt;/td&gt;
 &lt;td&gt;用于将日志记录到&lt;a href="https://slack.com/"&gt;Slack&lt;/a&gt;的钩子&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;a href="https://github.com/gemnasium/logrus-graylog-hook"&gt;Graylog&lt;/a&gt;&lt;/td&gt;
 &lt;td&gt;用于将日志记录到&lt;a href="http://graylog2.org/"&gt;Graylog&lt;/a&gt;的钩子&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;a href="https://github.com/nubo/hiprus"&gt;Hiprus&lt;/a&gt;&lt;/td&gt;
 &lt;td&gt;将错误发送到Hipchat频道的钩子&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;a href="https://github.com/agonzalezro/logrus_honeybadger"&gt;Honeybadger&lt;/a&gt;&lt;/td&gt;
