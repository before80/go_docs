 &lt;th&gt;默认值&lt;/th&gt;
 &lt;th&gt;占用字节数&lt;/th&gt;
 &lt;th&gt;数据最小值&lt;/th&gt;
 &lt;th&gt;数据最大值&lt;/th&gt;
 &lt;th&gt;备注&lt;/th&gt;
 &lt;th&gt;链接&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;1&lt;/td&gt;
 &lt;td&gt;bool&lt;/td&gt;
 &lt;td&gt;布尔型&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;td&gt;false&lt;/td&gt;
 &lt;td&gt;1&lt;/td&gt;
 &lt;td&gt;无&lt;/td&gt;
 &lt;td&gt;无&lt;/td&gt;
 &lt;td&gt;只有true和false两种值&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;2&lt;/td&gt;
 &lt;td&gt;byte&lt;/td&gt;
 &lt;td&gt;字节型&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;td&gt;&amp;lsquo;\x00&amp;rsquo;（使用%q）0（使用%d）&lt;/td&gt;
 &lt;td&gt;1&lt;/td&gt;
 &lt;td&gt;&amp;lsquo;\x00&amp;rsquo;（使用%q）0（使用%d）&lt;/td&gt;
 &lt;td&gt;&amp;lsquo;\x7f&amp;rsquo;（使用%q）127（使用%d）&lt;/td&gt;
 &lt;td&gt;是uint8的别名&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;3&lt;/td&gt;
 &lt;td&gt;complex64&lt;/td&gt;
 &lt;td&gt;复数型&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;td&gt;(0+0i)&lt;/td&gt;
 &lt;td&gt;8&lt;/td&gt;
 &lt;td&gt;无&lt;/td&gt;
 &lt;td&gt;无&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;4&lt;/td&gt;
 &lt;td&gt;complex128&lt;/td&gt;
 &lt;td&gt;复数型&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;td&gt;(0+0i)&lt;/td&gt;
 &lt;td&gt;16&lt;/td&gt;
 &lt;td&gt;无&lt;/td&gt;
 &lt;td&gt;无&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;td&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;5&lt;/td&gt;
